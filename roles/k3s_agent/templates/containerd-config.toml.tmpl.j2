version = 2

[plugins]
[plugins."io.containerd.grpc.v1.cri"]
{% if k3s_common_containerd_optimized | default(true) %}
  stream_idle_timeout = "30m"
  max_container_log_line_size = 16384
  max_concurrent_downloads = 3
  enable_unprivileged_ports = true
  enable_unprivileged_icmp = true
  sandbox_image = "registry.k8s.io/pause:3.10.1"
{% endif %}

[plugins."io.containerd.grpc.v1.cri".containerd]
{% set _default_runtime = k3s_common_containerd_default_runtime | default('runc') %}
  default_runtime_name = "{{ _default_runtime }}"
  snapshotter = "overlayfs"
{% if k3s_common_containerd_optimized | default(true) %}
  disable_snapshot_annotations = false
  discard_unpacked_layers = true
{% endif %}

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes]
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
  runtime_type = "io.containerd.runc.v2"

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
  SystemdCgroup = true
{% if k3s_common_containerd_optimized | default(true) %}
  BinaryName = "/usr/bin/runc"
{% endif %}

{% if 'nvidia' in (k3s_common_containerd_additional_runtimes | default([])) %}
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.nvidia]
  runtime_type = "io.containerd.runc.v2"
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.nvidia.options]
  BinaryName = "/usr/bin/nvidia-container-runtime"
  SystemdCgroup = true
{% endif %}

{% if 'runsc' in (k3s_common_containerd_additional_runtimes | default([])) %}
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
{% endif %}

[plugins."io.containerd.grpc.v1.cri".cni]
  bin_dir = "{{ k3s_cni_bin_dir }}"
  conf_dir = "{{ k3s_cni_conf_dir }}"

{% if k3s_common_containerd_optimized | default(true) %}
[plugins."io.containerd.grpc.v1.cri".registry]
  config_path = "/etc/containerd/certs.d"

[plugins."io.containerd.gc.v1.scheduler"]
  deletion_threshold = 50
  mutation_threshold = 100
  schedule_delay = "30s"
  startup_delay = "100ms"
{% endif %}
