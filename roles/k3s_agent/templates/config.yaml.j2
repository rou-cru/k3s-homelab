# /etc/rancher/k3s/config.yaml - Managed by Ansible
# Declarative configuration for K3s Agent

# Server connection
server: "{{ k3s_agent_server_url }}"
token: "{{ k3s_agent_token }}"

# Network - Bind to Tailscale IP for secure inter-node communication
node-ip: "{{ tailscale_ip }}"

# Kube-proxy - Must match server configuration (Cilium replacement)
disable-kube-proxy: true

{% if k3s_agent_node_labels | length > 0 %}
# Node labels
node-label:
{%     for label in k3s_agent_node_labels %}
  - "{{ label }}"
{%     endfor %}
{% endif %}

{% if k3s_agent_node_taints | length > 0 %}
# Node taints
node-taint:
{%     for taint in k3s_agent_node_taints %}
  - "{{ taint }}"
{%     endfor %}
{% endif %}

{% if k3s_agent_kubelet_args is defined and k3s_agent_kubelet_args | length > 0 %}
# Kubelet arguments
kubelet-arg:
{%     for arg in k3s_agent_kubelet_args %}
  - "{{ arg }}"
{%     endfor %}
{% endif %}
