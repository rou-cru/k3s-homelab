# /etc/rancher/k3s/config.yaml - Managed by Ansible
# Declarative configuration for K3s Agent

# Server connection
server: "{{ k3s_agentServerUrl }}"
token: "{{ k3s_agentToken }}"

# Network - Bind to Tailscale IP for secure inter-node communication
node-ip: "{{ IP_tailscale }}"

# Kube-proxy - Must match server configuration (Cilium replacement)
disable-kube-proxy: true

{% if k3s_agentNodeLabels | length > 0 %}
# Node labels
node-label:
{%     for label in k3s_agentNodeLabels %}
  - "{{ label }}"
{%     endfor %}
{% endif %}

{% if k3s_agentNodeTaints | length > 0 %}
# Node taints
node-taint:
{%     for taint in k3s_agentNodeTaints %}
  - "{{ taint }}"
{%     endfor %}
{% endif %}

{% if k3s_agentKubeletArgs is defined and k3s_agentKubeletArgs | length > 0 %}
# Kubelet arguments
kubelet-arg:
{%     for arg in k3s_agentKubeletArgs %}
  - "{{ arg }}"
{%     endfor %}
{% endif %}
