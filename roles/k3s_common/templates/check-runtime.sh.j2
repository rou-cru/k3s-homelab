#!/bin/bash
# {{ ansible_managed }}
# Script to verify containerd runtime availability

set -euo pipefail

# Check if runtime passed as argument exists
if [ -z "${1:-}" ]; then
    echo "Usage: $0 <runtime-name>"
    exit 1
fi

RUNTIME="$1"

case "$RUNTIME" in
    nvidia)
        if command -v nvidia-container-runtime &> /dev/null; then
            echo "nvidia-container-runtime available"
            exit 0
        else
            echo "nvidia-container-runtime NOT found"
            exit 1
        fi
        ;;
    runsc)
        if command -v runsc &> /dev/null; then
            echo "runsc (gVisor) available"
            exit 0
        else
            echo "runsc NOT found"
            exit 1
        fi
        ;;
    runc)
        if command -v runc &> /dev/null; then
            echo "runc available"
            exit 0
        else
            echo "runc NOT found"
            exit 1
        fi
        ;;
    *)
        echo "Unknown runtime: $RUNTIME"
        exit 2
        ;;
esac
