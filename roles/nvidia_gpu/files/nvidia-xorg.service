[Unit]
Description=NVIDIA X Server for headless GPU management
After=multi-user.target
Requires=nvidia-persistence.service
After=nvidia-persistence.service

[Service]
Type=simple
ExecStart=/usr/bin/X :1 -config /etc/X11/xorg.conf -novtswitch -sharevts
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
