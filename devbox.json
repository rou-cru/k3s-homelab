{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "shellcheck@0.11.0",
    "shfmt@3.12.0",
    "yamllint@1.37.1",
    "yamlfmt@0.20.0",
    "j2lint@1.2.0",
    "j2cli@0.3.10",
    "go-task@3.45.5",
    "helm@latest",
    "k9s@latest",
    "ripgrep@latest",
    "ansible@latest",
    "ansible-lint@latest",
    "ansible-doctor@latest"
  ],
  "shell": {
    "init_hook": [
      "export workspaceFolder=$PWD",
      "export CODEX_HOME=$workspaceFolder/.codex"
    ]
  }
}
