{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "env": {
    "UV_VENV_CLEAR": "1",
    "UV_PYTHON":     "3.12"
  },
  "packages": [
    "shellcheck@0.11.0",
    "shfmt@3.12.0",
    "yamllint@1.37.1",
    "yamlfmt@0.20.0",
    "j2lint@1.2.0",
    "j2cli@0.3.10",
    "go-task@3.45.5",
    "helm@latest",
    "k9s@latest",
    "ripgrep@latest",
    "checkov@latest",
    "ansible@latest",
    "python@3.12",
    "uv@latest",
    "trufflehog@latest",
    "sshpass@latest"
  ],
  "shell": {
    "init_hook": [
      "export workspaceFolder=$PWD",
      "export CODEX_HOME=$workspaceFolder/.codex",
      "export ANSIBLE_COLLECTIONS_PATH=$workspaceFolder/.ansible/collections",
      "export ANSIBLE_ROLES_PATH=$workspaceFolder/roles",
      "uv venv .venv",
      "source .venv/bin/activate",
      "uv sync"
    ]
  }
}
