---
# Ansible-lint configuration for k3s-homelab

# Exclude upstream files from linting
exclude_paths:
  - roles/cilium/files/cilium-values.yaml  # Upstream Cilium Helm values

# Skip var-naming rule (we use consistent prefixes already)
skip_list:
  - var-naming[no-role-prefix]

# Use production profile for strict validation
profile: production

# Warn on long lines but don't fail
warn_list:
  - yaml[line-length]
