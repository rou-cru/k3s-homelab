# Dynamic overrides for external-secrets
serviceMonitor:
  enabled: {{ externalSecrets_serviceMonitorEnabled | bool | lower }}
webhook:
  serviceMonitor:
    enabled: {{ externalSecrets_serviceMonitorEnabled | bool | lower }}
  certManager:
    cert:
      issuerRef:
        group: cert-manager.io
        kind: ClusterIssuer
        name: "{{ externalSecrets_webhookIssuerName }}"
grafanaDashboard:
  enabled: {{ externalSecrets_grafanaDashboardEnabled | bool | lower }}
