# ------------------------------------------------------------------------------
# KUBERNETES API DISCOVERY
# ------------------------------------------------------------------------------
# Point Cilium to the Tailscale IP of the control plane
# This is critical for hybrid setups where direct L2 broadcast isn't available
k8sServiceHost: "{{ IP_tailscale }}"

# ------------------------------------------------------------------------------
# NATIVE ROUTING CIDR SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Ensures Cilium uses the same PodCIDR range as defined in Ansible variables,
# preventing mismatch with Tailscale routing rules (fix-tailscale-cilium-routing).
#ipv4NativeRoutingCIDR: "{{ cilium_native_routing_cidr }}"
